generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["rhel-openssl-3.0.x", "native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Club {
  id           String   @id @default(cuid())
  name         String   @unique
  city         String
  country      String
  founded      String
  emblem       String   @default("")
  primaryKit   String   @default("")
  secondaryKit String   @default("")
  strength     Float    @default(5.0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stadiumRel  Stadium?    @relation("ClubStadium")
  coach       Coach?
  players     Player[]
  homeMatches Match[]     @relation("HomeTeam")
  awayMatches Match[]     @relation("AwayTeam")
  standings   Standing[]
  awards      Award[]
  news        News[]
  sponsors    Sponsor[]
  matchStats  MatchStat[]
}

model Coach {
  id          String   @id @default(cuid())
  name        String
  nationality String
  age         Int
  clubId      String   @unique
  club        Club?    @relation(fields: [clubId], references: [id])
  overall     Int      @default(50)
  photo       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  awards      Award[]
}

model Player {
  id              String   @id @default(cuid())
  name            String
  age             Int
  nationality     String
  clubId          String?
  club            Club?    @relation(fields: [clubId], references: [id])
  position        String
  number          Int
  dominantFoot    String
  height          Float
  weight          Float
  overall         Int      @default(50)
  pace            Int      @default(50)
  shooting        Int      @default(50)
  passing         Int      @default(50)
  dribbling       Int      @default(50)
  defending       Int      @default(50)
  physical        Int      @default(50)
  goalkeeperStats Int      @default(50)
  photo           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  matchStats MatchStat[]
  awards     Award[]
  seasons    SeasonStat[]
  transfers  Transfer[]
}

model Referee {
  id          String   @id @default(cuid())
  name        String
  nationality String
  age         Int
  photo       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Stadium {
  id        String   @id @default(cuid())
  name      String   @unique
  city      String
  country   String
  capacity  Int
  image     String   @default("")
  clubId    String?  @unique
  club      Club?    @relation("ClubStadium", fields: [clubId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model League {
  id        String   @id @default(cuid())
  name      String   @unique
  logo      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seasons   Season[]
}

model Season {
  id           String        @id @default(cuid())
  name         String
  leagueId     String?
  league       League?       @relation(fields: [leagueId], references: [id])
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  competitions Competition[]
  awards       Award[]
  stats        SeasonStat[]
}

model Competition {
  id         String   @id @default(cuid())
  name       String
  type       String
  logo       String   @default("")
  seasonId   String?
  season     Season?  @relation(fields: [seasonId], references: [id])
  isKnockout Boolean  @default(false)
  format     String   @default("round-robin")
  numTeams   Int      @default(0)
  numTurns   Int      @default(2)
  promoted   Int      @default(0)
  relegated  Int      @default(0)
  qualifiedLibertadores Int @default(0)
  qualifiedSulAmericana Int @default(0)
  pointsPerWin    Int  @default(3)
  pointsPerDraw   Int  @default(1)
  hasExtraTime    Boolean @default(false)
  hasPenalties    Boolean @default(false)
  maxSubstitutions Int @default(5)
  maxCardsBeforeSuspension Int @default(3)
  tiebreaker1 String @default("points")
  tiebreaker2 String @default("wins")
  tiebreaker3 String @default("goalDiff")
  tiebreaker4 String @default("goalsFor")
  tiebreaker5 String @default("head-to-head")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  groups     Group[]
}

model Group {
  id            String       @id @default(cuid())
  name          String
  competitionId String?
  competition   Competition? @relation(fields: [competitionId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  standings    Standing[]
  matches       Match[]
}

model Standing {
  id           String   @id @default(cuid())
  groupId      String?
  group        Group?   @relation(fields: [groupId], references: [id])
  clubId       String?
  club         Club?    @relation(fields: [clubId], references: [id])
  points       Int      @default(0)
  played       Int      @default(0)
  wins         Int      @default(0)
  draws        Int      @default(0)
  losses       Int      @default(0)
  goalsFor     Int      @default(0)
  goalsAgainst Int      @default(0)
  goalsDiff    Int      @default(0)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Match {
  id          String      @id @default(cuid())
  groupId     String?
  group       Group?      @relation(fields: [groupId], references: [id])
  homeTeamId  String?
  homeTeam    Club?       @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId  String?
  awayTeam    Club?       @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore   Int?
  awayScore   Int?
  round       String?
  matchDate   DateTime?
  status      String      @default("scheduled")
  isKnockout  Boolean     @default(false)
  isSimulated Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  matchStats  MatchStat[]
  reports     MatchReport[]
}

model MatchStat {
  id            String   @id @default(cuid())
  matchId       String?
  match         Match?   @relation(fields: [matchId], references: [id])
  playerId      String?
  player        Player?  @relation(fields: [playerId], references: [id])
  clubId        String?
  club          Club?    @relation(fields: [clubId], references: [id])
  goals         Int      @default(0)
  assists       Int      @default(0)
  powerShots    Int      @default(0)
  shots         Int      @default(0)
  shotsOnTarget Int      @default(0)
  passes        Int      @default(0)
  passAccuracy  Int      @default(0)
  tackles       Int      @default(0)
  interceptions Int      @default(0)
  saves         Int      @default(0)
  cleanSheet    Boolean  @default(false)
  yellowCards   Int      @default(0)
  redCards      Int      @default(0)
  minutesPlayed Int      @default(0)
  mvp           Boolean  @default(false)
  rating        Float    @default(6.0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SeasonStat {
  id            String   @id @default(cuid())
  playerId      String?
  player        Player?  @relation(fields: [playerId], references: [id])
  seasonId      String?
  season        Season?  @relation(fields: [seasonId], references: [id])
  matches       Int      @default(0)
  goals         Int      @default(0)
  assists       Int      @default(0)
  powerShots    Int      @default(0)
  mvpCount      Int      @default(0)
  yellowCards   Int      @default(0)
  redCards      Int      @default(0)
  minPlayed     Int      @default(0)
  averageRating Float    @default(0)
  cleanSheets   Int      @default(0)
  saves         Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Award {
  id        String   @id @default(cuid())
  title     String
  category  String
  playerId  String?
  player    Player?  @relation(fields: [playerId], references: [id])
  clubId    String?
  club      Club?    @relation(fields: [clubId], references: [id])
  coachId   String?
  coach     Coach?   @relation(fields: [coachId], references: [id])
  seasonId  String?
  season    Season?  @relation(fields: [seasonId], references: [id])
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sponsor {
  id        String   @id @default(cuid())
  name      String   @unique
  logo      String   @default("")
  category  String   @default("")
  clubId    String?
  club      Club?    @relation(fields: [clubId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model News {
  id        String   @id @default(cuid())
  title     String
  content   String
  image     String   @default("")
  category  String
  author    String
  clubId    String?
  club      Club?    @relation(fields: [clubId], references: [id])
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comments  Comment[]
}

model MapFile {
  id          String   @id @default(cuid())
  name        String
  description String?
  fileUrl     String
  category    String   @default("map")
  version     String   @default("1.0")
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String?  @unique
  password  String
  role      String   @default("user")
  avatar    String   @default("")
  discord   String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comments  Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  newsId    String
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  authorName String  @default("Anonimo")
  content   String
  createdAt DateTime @default(now())
}

model Transfer {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  fromClubId String?
  toClubId  String?
  date      DateTime @default(now())
  fee       String   @default("")
  type      String   @default("transfer")
  createdAt DateTime @default(now())
}

model Log {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  adminId   String?
  details   String   @default("")
  createdAt DateTime @default(now())
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String   @default("HaxBall Integration")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  matches   MatchReport[]
}

model MatchReport {
  id            String   @id @default(cuid())
  apiKeyId      String?
  apiKey        ApiKey?  @relation(fields: [apiKeyId], references: [id])
  matchId       String?
  match         Match?   @relation(fields: [matchId], references: [id])
  redTeamName   String
  blueTeamName  String
  redScore      Int      @default(0)
  blueScore     Int      @default(0)
  redPossession Float    @default(50)
  bluePossession Float   @default(50)
  mvpPlayerName String?
  mvpRating     Float    @default(0)
  events        String   @default("[]")
  playerStats   String   @default("[]")
  teamStats     String   @default("[]")
  penaltyShootout String @default("{}")
  createdAt     DateTime @default(now())
}
